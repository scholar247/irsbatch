# Staging environment config. Next.js does NOT auto-load this file (it only recognizes
# development/production for automatic env-file selection), so it's loaded explicitly by
# scripts/run-with-env.js via the npm scripts below:
#   npm run dev:staging / build:staging / start:staging
#
# Currently points at the same Firebase project as development (irs-batch-dev) — swap
# FIREBASE_PROJECT_ID/FIREBASE_STORAGE_BUCKET/FIREBASE_CLIENT_EMAIL/FIREBASE_PRIVATE_KEY
# below once a dedicated staging Firebase project exists.

APP_ENV=staging

FIREBASE_PROJECT_ID=irs-batch-dev
FIREBASE_STORAGE_BUCKET=irs-batch-dev.firebasestorage.app
# From Firebase Console > Project Settings > Service Accounts > Generate new private key.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# JWT secrets — generate with: openssl rand -base64 48 (use different values than dev/prod)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACTIVATION_SECRET=
