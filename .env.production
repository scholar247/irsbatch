# Production environment config. Next.js loads this automatically whenever
# NODE_ENV=production (i.e. `next build` / `next start`, and most hosting providers).
#
# Currently points at the same Firebase project as development (irs-batch-dev) — swap
# FIREBASE_PROJECT_ID/FIREBASE_STORAGE_BUCKET/FIREBASE_CLIENT_EMAIL/FIREBASE_PRIVATE_KEY
# below once a dedicated production Firebase project exists. Do not ship real member data
# against a project named "-dev" long term.

APP_ENV=production

FIREBASE_PROJECT_ID=irs-batch-dev
FIREBASE_STORAGE_BUCKET=irs-batch-dev.firebasestorage.app
# From Firebase Console > Project Settings > Service Accounts > Generate new private key.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# JWT secrets — generate with: openssl rand -base64 48 (use different values than dev/staging)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACTIVATION_SECRET=
