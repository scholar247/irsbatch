rules_version = '2';

// Deny-all, deliberately. This app never talks to Firestore from a browser or mobile
// client SDK — every read and write goes through the Next.js server via the Firebase
// Admin SDK (src/lib/firebase/admin.ts), which authenticates as a service account and
// bypasses these rules entirely (Admin SDK access is governed by IAM, not by
// firestore.rules). These rules exist purely as defense-in-depth: if a client SDK is ever
// misconfigured or a key leaks, this still blocks direct access. The real authorization
// boundary is src/lib/rbac/guard.ts.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
