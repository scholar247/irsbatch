# Copy to .env.local and fill in real values. Never commit .env.local.

APP_ENV=development

# Firebase Admin SDK (service account) — from Firebase Console > Project Settings > Service Accounts.
# Do NOT set up Firebase Authentication; this app uses none of it.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from the service account JSON, keeping \n escape sequences as-is.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# JWT secrets — generate with: openssl rand -base64 48
# Use three DIFFERENT secrets so a leak of one token type can't be replayed as another.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACTIVATION_SECRET=

# Optional overrides (defaults shown)
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=2592000
# JWT_ACTIVATION_TTL_SECONDS=604800
